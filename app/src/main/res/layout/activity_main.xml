<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/preview_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <org.andrewgao.sony.aspectratio.ui.CropOverlayView
        android:id="@+id/crop_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginTop="8px">

        <ImageView
            android:id="@+id/mode_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mode_text"
            style="@style/OsdShadow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8px"
            android:includeFontPadding="false"
            android:text="--"
            android:textSize="30px" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="32px"
        android:layout_gravity="top|left"
        android:layout_marginLeft="112px"
        android:layout_marginTop="4px"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/shots_icon"
            android:layout_width="39px"
            android:layout_height="27px"
            android:layout_marginRight="4px"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <TextView
            android:id="@+id/shots_text"
            style="@style/OsdShadow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="--"
            android:textSize="26px" />
    </LinearLayout>

    <TextView
        android:id="@+id/aspect_chip"
        style="@style/OsdShadow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8px"
        android:background="@drawable/osd_chip"
        android:includeFontPadding="false"
        android:paddingLeft="6px"
        android:paddingTop="2px"
        android:paddingRight="6px"
        android:paddingBottom="2px"
        android:textSize="26px" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="32px"
        android:layout_gravity="top|right"
        android:layout_marginTop="4px"
        android:layout_marginRight="19px"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/battery_icon"
            android:layout_width="41px"
            android:layout_height="27px"
            android:layout_marginRight="4px"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <TextView
            android:id="@+id/battery_text"
            style="@style/OsdShadow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="--"
            android:textSize="26px" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="0px"
        android:layout_marginBottom="52px">

        <ImageView
            android:id="@+id/focus_mode_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:visibility="gone" />

        <TextView
            android:id="@+id/focus_mode_text"
            style="@style/OsdShadow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_marginLeft="8px"
            android:includeFontPadding="false"
            android:textSize="26px"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="52px"
        android:layout_gravity="bottom"
        android:background="#FF000000">

        <ImageView
            android:id="@+id/focus_icon"
            android:layout_width="28px"
            android:layout_height="28px"
            android:layout_gravity="top|left"
            android:layout_marginLeft="10px"
            android:layout_marginTop="12px"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/focus_indicator"
            style="@style/OsdShadow"
            android:layout_width="28px"
            android:layout_height="28px"
            android:layout_gravity="top|left"
            android:layout_marginLeft="10px"
            android:layout_marginTop="12px"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="●"
            android:textSize="20px"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shutter_text"
                style="@style/OsdShadow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="--"
                android:textSize="39px" />

            <TextView
                android:id="@+id/aperture_text"
                style="@style/OsdShadow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="50px"
                android:includeFontPadding="false"
                android:text="--"
                android:textSize="39px" />

            <TextView
                android:id="@+id/exposure_text"
                style="@style/OsdShadow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="50px"
                android:includeFontPadding="false"
                android:text="--"
                android:textSize="39px" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="50px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iso_icon"
                    android:layout_width="52px"
                    android:layout_height="37px"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/iso_label"
                    style="@style/OsdShadow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/iso_label"
                    android:textSize="20px"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/iso_value"
                    style="@style/OsdShadow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4px"
                    android:includeFontPadding="false"
                    android:text="--"
                    android:textSize="39px" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/processing"
        style="@style/OsdShadow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/osd_chip"
        android:includeFontPadding="false"
        android:paddingLeft="6px"
        android:paddingTop="2px"
        android:paddingRight="6px"
        android:paddingBottom="2px"
        android:text="@string/processing"
        android:textSize="26px"
        android:visibility="gone" />

</FrameLayout>
